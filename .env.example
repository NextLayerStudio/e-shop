# --- Databáza & admin ---
# Neon pooler URL (na Verceli bez úvodzoviek okolo celej hodnoty!)
# Odporúčané: ...-pooler....neon.tech/neondb?sslmode=require
# (parameter channel_binding=require môže na serverless občas robiť problémy — vyskúšaj bez neho)
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="silne-heslo"
# Vygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET="min-16-znakov-náhodný-reťazec"

# --- Verejný e-shop (odkazy v emailoch); na Verceli často doplní sa VERCEL_URL ak chýba ---
# NEXT_PUBLIC_SITE_URL="https://tvoja-domena.sk"

# --- Resend: na Verceli pridaj v Project → Settings → Environment Variables (Production) + Redeploy ---
# https://resend.com — EMAIL_FROM musí byť na doméne overenej v Resend (nie @resend.dev pre zákazníkov).
# RESEND_API_KEY="re_..."
# EMAIL_FROM="know3d <objednavky@know3d.sk>"

# --- Pay by Square — QR platba (pure JS, funguje na Verceli bez xz) ---
PAYMENT_IBAN="SK29XXXXXXXXXXXXXXXXXXXX"
PAYMENT_SWIFT=""
PAYMENT_RECIPIENT_NAME="know3d"

# --- Packeta — REST API (pre admin: vytvorenie zásielky + PDF štítok) ---
# Nájdeš v Packeta účte: Profil → API kľúče → Heslo API
PACKETA_API_PASSWORD="tvoje-api-heslo"
PACKETA_ESHOP="nazov-tvojho-eshopu"
PACKETA_API_URL="https://www.zasilkovna.cz/api/rest"
PACKETA_DEFAULT_WEIGHT_KG="0.5"
PACKETA_DEFAULT_CURRENCY="EUR"
PACKETA_LABEL_FORMAT="A6 on A6"

# --- Packeta — Widget (pre zákazníkov: výber pobočky) ---
# Nájdeš v Packeta účte: Profil → API kľúče → Kľúč API
NEXT_PUBLIC_PACKETA_API_KEY="tvoj-verejny-api-kluc"
