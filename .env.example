# =============================================================================
# Database (Neon PostgreSQL)
# Vyrob si free databázu na https://neon.tech a sem skopíruj "Pooled connection"
# Príklad: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# =============================================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# =============================================================================
# Admin prihlasovacie údaje (jednoduchý login z .env)
# =============================================================================
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Tajný kľúč pre podpisovanie session cookie (min. 32 znakov, ideálne náhodný).
# Vygeneruj napr. cez: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET="vlozte-sem-velmi-dlhy-nahodny-retazec-min-32-znakov"
