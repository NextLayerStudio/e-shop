// Prisma schema for the know3D e-shop
// Database: Neon (PostgreSQL)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// PRODUCTS
// =====================================================================

enum ProductCategory {
  PRIVESKY_MAGNETKY
  SPOLOCENSKE_HRY
  SKLADACKY_HLAVOLAMY
  INTERAKTIVNE_HRACKY
  NA_ORGANIZOVANIE
  OSTATNE
}

model Product {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  description     String          @db.Text
  shortDescription String?        @db.Text
  priceCents      Int             // price in cents (e.g. 1999 = 19,99 €); pri variantoch = „od" cena (min)
  stock           Int             @default(0)
  category        ProductCategory @default(OSTATNE)

  // Varianty (figúrka / kľúčenka) — voliteľné, s vlastnou cenou
  hasVariants        Boolean @default(false)
  figurkaPriceCents  Int?
  klucenkaPriceCents Int?

  // Visibility / curation
  isActive        Boolean         @default(true)
  isFeaturedHome  Boolean         @default(false) // shows in the home grid
  isHitOfWeek     Boolean         @default(false) // shows in "Hit týždňa" banner
  homeSortOrder   Int             @default(0)     // ordering on home page
  salesCount      Int             @default(0)     // popularity tracker

  images          ProductImage[]
  orderItems      OrderItem[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([isActive])
  @@index([isFeaturedHome])
  @@index([category])
}

// Images are stored directly in the database as bytes (per user request: "Prisma")
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  data      Bytes    // raw image bytes
  mimeType  String   // e.g. image/jpeg, image/png, image/webp
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([productId, sortOrder])
}

// =====================================================================
// ORDERS
// =====================================================================

enum OrderStatus {
  NEW
  CONFIRMED
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

model PromoCode {
  id              String            @id @default(cuid())
  code            String            @unique
  note            String?           @db.Text // internal admin note
  discountType    PromoDiscountType
  percentOff      Int? // 1–100 when PERCENT
  amountOffCents  Int? // when FIXED, amount in cents
  startsAt        DateTime          @default(now())
  endsAt          DateTime? // null = no end date
  isActive        Boolean           @default(true)
  /// Minimum cart subtotal (cents) required to apply this code; null = no minimum
  minOrderCents   Int?

  orders          Order[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([code])
  @@index([isActive])
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique // human-friendly e.g. "2026-000123"

  customerName    String
  customerEmail   String
  customerPhone   String?

  address         String
  city            String
  postalCode      String
  country         String       @default("Slovensko")

  note            String?      @db.Text
  totalCents      Int
  discountCents   Int          @default(0)
  shippingCents   Int          @default(0)
  shippingMethodId  String?
  shippingLabel     String?

  promoCodeId     String?
  promoCode       PromoCode?   @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  /// Snapshot of the entered code at checkout (for history if promo is deleted)
  promoSnapshot   String?

  /// Pay by Square QR kód ako base64 data URL (generovaný pri vytvorení objednávky)
  qrCodeDataUrl   String?      @db.Text

  // Packeta — výdajné miesto (vyplní zákazník pri checkouts)
  packetaPointId      String?
  packetaPointName    String?
  packetaPointAddress String?
  packetaIsoCountry   String?   // SK / CZ

  // Packeta — fulfillment (vyplní admin po zaplatení)
  packetaPacketId         String?  @unique
  packetaTrackingNumber   String?
  packetaStatus           String?  // created | label_ready | error
  packetaCreatedAt        DateTime?
  packetaError            String?  @db.Text

  status          OrderStatus  @default(NEW)

  items           OrderItem[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot fields (so the order stays correct even if product changes)
  productName     String
  unitPriceCents  Int
  quantity        Int

  @@index([orderId])
  @@index([productId])
}

// =====================================================================
// TLAČ NA MIERU (Custom Print Requests)
// =====================================================================

enum CustomPrintStatus {
  NEW
  IN_REVIEW
  QUOTED
  ACCEPTED
  REJECTED
  COMPLETED
}

model CustomPrintRequest {
  id              String            @id @default(cuid())
  requestNumber   String            @unique // e.g. "TLAC-2026-000045"

  customerName    String
  customerEmail   String
  customerPhone   String?

  description     String            @db.Text
  // Optional uploaded file (e.g. STL/OBJ) – stored in DB
  fileData        Bytes?
  fileName        String?
  fileMimeType    String?
  fileSizeBytes   Int?

  status          CustomPrintStatus @default(NEW)
  adminNote       String?           @db.Text
  quotedPriceCents Int?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}
